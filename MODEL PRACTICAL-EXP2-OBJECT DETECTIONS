import cv2
import numpy as np
import matplotlib.pyplot as plt
from PIL import Image

# Load the AVIF image using Pillow
pil_img = Image.open('/content/photo-1651787957245-3d760746a717.avif')
img_rgb = np.array(pil_img.convert('RGB'))

# Convert RGB (Pillow format) to BGR for standard OpenCV pipeline
img_bgr = cv2.cvtColor(img_rgb, cv2.COLOR_RGB2BGR)

# Convert BGR to HSV
hsv = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2HSV)

# Set blue color range boundaries
lower_blue = np.array([90, 50, 50])
upper_blue = np.array([130, 255, 255])

# Create a binary mask
mask = cv2.inRange(hsv, lower_blue, upper_blue)

# Extract the blue region using bitwise AND
result_bgr = cv2.bitwise_and(img_bgr, img_bgr, mask=mask)
result_rgb = cv2.cvtColor(result_bgr, cv2.COLOR_BGR2RGB)

# Save standard image outputs
cv2.imwrite('mask.jpg', mask)
cv2.imwrite('output.jpg', result_bgr)

# Display the results inline using matplotlib
fig, axes = plt.subplots(1, 3, figsize=(18, 6))
axes[0].imshow(img_rgb)
axes[0].set_title('Original Image')
axes[0].axis('off')

axes[1].imshow(mask, cmap='gray')
axes[1].set_title('Binary Mask (Blue Sky)')
axes[1].axis('off')

axes[2].imshow(result_rgb)
axes[2].set_title('Extracted Sky Region')
axes[2].axis('off')

plt.tight_layout()
plt.show()
